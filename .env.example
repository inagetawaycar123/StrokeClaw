# StrokeClaw runtime configuration (copy to .env and supply real secrets locally).
SUPABASE_URL=
SUPABASE_ANON_KEY=
FLASK_SECRET_KEY=
BAICHUAN_API_URL=https://api.baichuan-ai.com/v1/chat/completions
BAICHUAN_API_KEY=
BAICHUAN_MODEL=Baichuan-M3

# Rule-based NIfTI image quality control.
IMAGE_QC_ENABLED=1
IMAGE_QC_ALLOW_SINGLE_SLICE=1
IMAGE_QC_MAX_SLICE_THICKNESS_MM=5.0
IMAGE_QC_MIN_COVERAGE_MM=120.0
IMAGE_QC_MIN_VALID_SLICES=10
IMAGE_QC_MIN_FINITE_RATIO=0.999
IMAGE_QC_MOTION_WARN_BAD_PAIR_RATIO=0.10
IMAGE_QC_MOTION_FAIL_BAD_PAIR_RATIO=0.25
IMAGE_QC_MOTION_MAX_SHIFT_MM=3.0
IMAGE_QC_MOTION_MIN_CORRELATION=0.60
IMAGE_QC_GEOMETRY_AFFINE_ATOL_MM=1.0
