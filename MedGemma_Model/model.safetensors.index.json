### 7.1 å™ªå£°å¤„ç†å®žçŽ°
```python
def denoise_slice(self, slice_data, method='gaussian', sigma=1.0):
    """
    å¯¹åˆ‡ç‰‡æ•°æ®è¿›è¡Œå™ªå£°åŽ»é™¤
    Args:
        slice_data: åˆ‡ç‰‡æ•°æ®
        method: åŽ»å™ªæ–¹æ³• ('gaussian', 'median', 'non_local_means')
        sigma: é«˜æ–¯æ»¤æ³¢çš„sigmaå€¼
    Returns:
        np.ndarray: åŽ»å™ªåŽçš„åˆ‡ç‰‡æ•°æ®
    """
    if method == 'gaussian':
        from scipy.ndimage import gaussian_filter
        return gaussian_filter(slice_data, sigma=sigma)
    elif method == 'median':
        from scipy.ndimage import median_filter
        return median_filter(slice_data, size=3)
    elif method == 'non_local_means':
        # å®žçŽ°éžå±€éƒ¨å‡å€¼æ»¤æ³¢
        pass
    return slice_data
```

### 7.2 å¯¹æ¯”åº¦è°ƒæ•´å®žçŽ°
```python
def enhance_contrast(self, slice_data, method='clahe', clip_limit=0.03):
    """
    å¢žå¼ºåˆ‡ç‰‡æ•°æ®çš„å¯¹æ¯”åº¦
    Args:
        slice_data: åˆ‡ç‰‡æ•°æ®
        method: å¯¹æ¯”åº¦å¢žå¼ºæ–¹æ³• ('clahe', 'percentile')
        clip_limit: CLAHEçš„clip limit
    Returns:
        np.ndarray: å¯¹æ¯”åº¦å¢žå¼ºåŽçš„åˆ‡ç‰‡æ•°æ®
    """
    if method == 'clahe':
        from skimage.exposure import equalize_adapthist
        return equalize_adapthist(slice_data, clip_limit=clip_limit)
    elif method == 'percentile':
        # ç™¾åˆ†ä½æ ‡å‡†åŒ–
        p1 = np.percentile(slice_data, 1)
        p99 = np.percentile(slice_data, 99)
        return np.clip((slice_data - p1) / (p99 - p1), 0, 1)
    return slice_data
```

